# MySQL root password for local Docker development
MYSQL_ROOT_PASSWORD=change-this-root-password

# Application DB user is created by database/init.sql for local development.
# Change the papazone application password in database/init.sql and in the
# SPRING_DATASOURCE_PASSWORD values in docker-compose.yml before deployment.
PUBSUB_ENABLED=false
PUBSUB_PROJECT_ID=local-project
PUBSUB_TOPIC=order-events
PUBSUB_EMULATOR_HOST=localhost:8087
