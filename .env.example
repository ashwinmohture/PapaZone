# MySQL credentials
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE_PASSWORD=change-this-app-password

# JWT authentication (generate a strong random secret)
JWT_SECRET=replace-with-a-secure-random-secret

# Internal service authentication
INTERNAL_API_KEY=replace-with-a-long-random-key

# Gemini AI configuration
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Pub/Sub configuration
PUBSUB_ENABLED=false
PUBSUB_PROJECT_ID=local-project
PUBSUB_TOPIC=order-events
PUBSUB_EMULATOR_HOST=pubsub-emulator:8085

# RAG / pgvector (local development)
RAG_ENABLED=true
RAG_DB_PASSWORD=change_this_local_password
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIMENSIONS=768
RAG_TOP_K=5

# Razorpay payment gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Payment configuration
FREE_PAYMENT_ENABLED=true
FREE_PAYMENT_MAX_AMOUNT=0
UNPAID_ORDER_TTL_MINUTES=60
